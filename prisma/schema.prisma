generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Stage {
  NEW_LEAD
  FIRST_CONVERSATION
  FOLLOW_UP
  MEETING_SCHEDULED
  PROPOSAL_SENT
  VERBAL_COMMITMENT
  COMMITTED
  GIVING
  NOT_INTERESTED
}

model Prospect {
  id                String   @id @default(cuid())
  name              String
  organization      String?
  phone             String?
  email             String?
  stage             Stage    @default(NEW_LEAD)
  notes             String?
  estimatedAmount   Float?
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  archived          Boolean  @default(false)

  interactions Interaction[]

  @@index([stage])
  @@index([lastContactedAt])
}

model Interaction {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  note       String
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([prospectId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Singleton row (always id = 1) holding the login passcode once it's been
// changed from the app. Falls back to the APP_PASSCODE env var until then.
model AppSettings {
  id           Int      @id @default(1)
  passcodeHash String?
  updatedAt    DateTime @updatedAt
}
