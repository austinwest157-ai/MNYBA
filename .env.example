# Postgres connection string. For local dev, point this at a local Postgres
# instance. For production (e.g. Vercel), use a hosted Postgres connection
# string (Vercel Postgres/Neon/Supabase all work).
DATABASE_URL="postgresql://user:password@localhost:5432/mnyba"

# Passcode used to log into the CRM (single-user app). Choose something only you know.
APP_PASSCODE="change-me"

# Secret used to sign the login session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-too"

# Web Push (VAPID) keys - generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY
# (it's exposed to the browser so it can subscribe to push notifications).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Shared secret required by the /api/cron/check-followups endpoint so only your
# scheduler (e.g. Vercel Cron) can trigger follow-up push notifications.
CRON_SECRET="change-me-again"
